<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<title>BUNKER — прайс-лист бармена</title>
<style>
  @page { size: A4; margin: 1.5cm; }
  body { font-family: 'Georgia', 'Times New Roman', serif; color: #1a1a1a; }
  h1 { text-align: center; font-size: 26pt; margin-bottom: 0; letter-spacing: 2px; }
  .subtitle { text-align: center; font-size: 11pt; color: #555; margin-top: 4px; margin-bottom: 24px; }
  h2 { font-size: 16pt; border-bottom: 2px solid #B67A2B; padding-bottom: 4px; margin-top: 28px; color: #6b4419; }
  table { width: 100%; border-collapse: collapse; margin-top: 8px; margin-bottom: 4px; }
  td, th { padding: 4px 8px; font-size: 11pt; }
  th { text-align: left; border-bottom: 1px solid #999; font-size: 10pt; text-transform: uppercase; color: #555; }
  td.price { text-align: right; font-weight: bold; white-space: nowrap; }
  tr.item td { border-bottom: 1px dotted #ccc; }
  .group-title { font-weight: bold; font-size: 11pt; padding-top: 10px; color: #6b4419; }
  .note { font-size: 9pt; color: #999; font-style: italic; }
  .two-col { display: table; width: 100%; }
</style>
</head>
<body>

<h1>BUNKER</h1>
<div class="subtitle">Прайс-лист бармена — станом на серпень 2026</div>

<h2>Коктейлі</h2>
<table>
  <tr><th>Назва</th><th>Основа</th><th style="text-align:right;">Ціна</th></tr>
  <tr class="item"><td>Mint Julep</td><td>бурбон</td><td class="price">220 ₴</td></tr>
  <tr class="item"><td>Daiquiri</td><td>ром</td><td class="price">220 ₴</td></tr>
  <tr class="item"><td>Mojito</td><td>ром</td><td class="price">220 ₴</td></tr>
  <tr class="item"><td>Whisky-Cola</td><td>віскі</td><td class="price">220 ₴</td></tr>
  <tr class="item"><td>Blue Lagoon</td><td>горілка</td><td class="price">220 ₴</td></tr>
  <tr class="item"><td>Gin-Tonik</td><td>джин</td><td class="price">220 ₴</td></tr>
  <tr class="item"><td>Old Fashioned</td><td>бурбон</td><td class="price">240 ₴</td></tr>
  <tr class="item"><td>Manhattan</td><td>віскі</td><td class="price">240 ₴</td></tr>
  <tr class="item"><td>Godfather</td><td>віскі</td><td class="price">240 ₴</td></tr>
  <tr class="item"><td>Strawberry Mojito</td><td>ром</td><td class="price">240 ₴</td></tr>
  <tr class="item"><td>Espresso Martini</td><td>горілка</td><td class="price">240 ₴</td></tr>
  <tr class="item"><td>Boulevardier</td><td>бурбон</td><td class="price">250 ₴</td></tr>
  <tr class="item"><td>Negroni</td><td>джин</td><td class="price">250 ₴</td></tr>
  <tr class="item"><td>Aperol Spritz</td><td>апероль</td><td class="price">250 ₴</td></tr>
  <tr class="item"><td>Tequila Sunrise</td><td>текіла</td><td class="price">250 ₴</td></tr>
</table>

<h2>Шоти (50 мл, якщо не вказано інше)</h2>
<table>
  <tr><td class="group-title" colspan="2">Віскі</td></tr>
  <tr class="item"><td>White Horse</td><td class="price">130 ₴</td></tr>
  <tr class="item"><td>Johnnie Walker Red Label</td><td class="price">150 ₴</td></tr>
  <tr class="item"><td>Jack Daniel's</td><td class="price">190 ₴</td></tr>
  <tr class="item"><td>Jack Daniel's Blackberry</td><td class="price">210 ₴</td></tr>

  <tr><td class="group-title" colspan="2">Горілка · Текіла</td></tr>
  <tr class="item"><td>Zubrówka</td><td class="price">110 ₴</td></tr>
  <tr class="item"><td>Finlandia</td><td class="price">120 ₴</td></tr>
  <tr class="item"><td>Absolut Mandrin</td><td class="price">140 ₴</td></tr>
  <tr class="item"><td>True Tequila Silver</td><td class="price">160 ₴</td></tr>
  <tr class="item"><td>True Tequila Gold</td><td class="price">180 ₴</td></tr>

  <tr><td class="group-title" colspan="2">Джин</td></tr>
  <tr class="item"><td>Gordon's</td><td class="price">130 ₴</td></tr>
  <tr class="item"><td>Gordon's Tropical Passionfruit</td><td class="price">140 ₴</td></tr>
  <tr class="item"><td>Beefeater</td><td class="price">150 ₴</td></tr>
  <tr class="item"><td>Beefeater Blood Orange</td><td class="price">160 ₴</td></tr>

  <tr><td class="group-title" colspan="2">Лікери</td></tr>
  <tr class="item"><td>Becherovka</td><td class="price">110 ₴</td></tr>
  <tr class="item"><td>Jägermeister</td><td class="price">120 ₴</td></tr>
  <tr class="item"><td>Jägermeister Orange</td><td class="price">130 ₴</td></tr>
  <tr class="item"><td>Лікер вишневий (100 мл)</td><td class="price">130 ₴</td></tr>

  <tr><td class="group-title" colspan="2">Ром</td></tr>
  <tr class="item"><td>Bacardi Carta Blanca</td><td class="price">130 ₴</td></tr>
  <tr class="item"><td>Bacardi Spiced</td><td class="price">140 ₴</td></tr>
  <tr class="item"><td>Bacardi Carta Negra</td><td class="price">140 ₴</td></tr>

  <tr><td class="group-title" colspan="2">Бурбон · Бренді · Чача</td></tr>
  <tr class="item"><td>Бурбон Jim Beam</td><td class="price">170 ₴</td></tr>
  <tr class="item"><td>Чача Iveria Walnut</td><td class="price">150 ₴</td></tr>
  <tr class="item"><td>Бренді Fratelli XO</td><td class="price">230 ₴</td></tr>
</table>

<h2>Кава</h2>
<table>
  <tr><th>Назва</th><th style="text-align:right;">Ціна</th></tr>
  <tr class="item"><td>Еспресо</td><td class="price">70 ₴</td></tr>
  <tr class="item"><td>Американо</td><td class="price">80 ₴</td></tr>
  <tr class="item"><td>Капучино <span class="note">(скоро)</span></td><td class="price">100 ₴</td></tr>
  <tr class="item"><td>Латте <span class="note">(скоро)</span></td><td class="price">110 ₴</td></tr>
  <tr class="item"><td>Раф <span class="note">(скоро)</span></td><td class="price">140 ₴</td></tr>
</table>

<h2>Безалкогольні напої</h2>
<table>
  <tr><th>Назва</th><th>Об'єм</th><th style="text-align:right;">Ціна</th></tr>
  <tr class="item"><td>Моршинська (сл. газована / негазована)</td><td>0,3 л</td><td class="price">50 ₴</td></tr>
  <tr class="item"><td>Кола</td><td>0,25 л</td><td class="price">60 ₴</td></tr>
  <tr class="item"><td>Кола</td><td>0,3 л</td><td class="price">70 ₴</td></tr>
  <tr class="item"><td>Спрайт</td><td>0,3 л</td><td class="price">70 ₴</td></tr>
  <tr class="item"><td>Мохіто безалкогольне</td><td>—</td><td class="price">90 ₴</td></tr>
  <tr class="item"><td>Мохіто полуничне безалкогольне</td><td>—</td><td class="price">110 ₴</td></tr>
</table>

</body>
</html>
